<?php
// =============================================
// config/database.php - Database Configuration
// =============================================

class Database {
    private $host = "localhost";
    private $db_name = "faculty_consultation_db";
    private $username = "root";
    private $password = "";
    private $conn;

    public function getConnection() {
        $this->conn = null;
        try {
            $this->conn = new PDO(
                "mysql:host=" . $this->host . ";dbname=" . $this->db_name,
                $this->username,
                $this->password
            );
            $this->conn->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
            $this->conn->setAttribute(PDO::ATTR_DEFAULT_FETCH_MODE, PDO::FETCH_ASSOC);
        } catch(PDOException $e) {
            echo "Connection Error: " . $e->getMessage();
        }
        return $this->conn;
    }
}

// =============================================
// config/cors.php - CORS Headers
// =============================================

function setCorsHeaders() {
    header("Access-Control-Allow-Origin: *");
    header("Content-Type: application/json; charset=UTF-8");
    header("Access-Control-Allow-Methods: GET, POST, PUT, DELETE");
    header("Access-Control-Max-Age: 3600");
    header("Access-Control-Allow-Headers: Content-Type, Access-Control-Allow-Headers, Authorization, X-Requested-With");
}

// =============================================
// utils/email.php - Email Helper
// =============================================

function sendEmail($to, $subject, $message) {
    $headers = "MIME-Version: 1.0" . "\r\n";
    $headers .= "Content-type:text/html;charset=UTF-8" . "\r\n";
    $headers .= "From: Faculty Consultation System <noreply@university.edu>" . "\r\n";
    
    // For development: log email instead of sending
    error_log("EMAIL TO: $to\nSUBJECT: $subject\nMESSAGE: $message");
    
    // Uncomment for production
    // return mail($to, $subject, $message, $headers);
    
    return true; // Mock success for development
}

// =============================================
// api/faculty/register.php - Faculty Registration
// =============================================

setCorsHeaders();
require_once '../config/database.php';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $database = new Database();
    $db = $database->getConnection();
    
    $data = json_decode(file_get_contents("php://input"));
    
    if (!empty($data->name) && !empty($data->email) && !empty($data->password)) {
        
        // Check if email already exists
        $check_query = "SELECT id FROM faculty WHERE email = :email";
        $check_stmt = $db->prepare($check_query);
        $check_stmt->bindParam(":email", $data->email);
        $check_stmt->execute();
        
        if ($check_stmt->rowCount() > 0) {
            http_response_code(409);
            echo json_encode(["message" => "Email already registered"]);
            exit;
        }
        
        $query = "INSERT INTO faculty (name, email, password, department, phone) 
                  VALUES (:name, :email, :password, :department, :phone)";
        
        $stmt = $db->prepare($query);
        
        $hashed_password = password_hash($data->password, PASSWORD_BCRYPT);
        
        $stmt->bindParam(":name", $data->name);
        $stmt->bindParam(":email", $data->email);
        $stmt->bindParam(":password", $hashed_password);
        $stmt->bindParam(":department", $data->department);
        $stmt->bindParam(":phone", $data->phone);
        
        if ($stmt->execute()) {
            http_response_code(201);
            echo json_encode([
                "message" => "Faculty registered successfully",
                "faculty_id" => $db->lastInsertId()
            ]);
        } else {
            http_response_code(503);
            echo json_encode(["message" => "Unable to register faculty"]);
        }
    } else {
        http_response_code(400);
        echo json_encode(["message" => "Incomplete data"]);
    }
}

// =============================================
// api/faculty/login.php - Faculty Login
// =============================================

setCorsHeaders();
require_once '../config/database.php';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $database = new Database();
    $db = $database->getConnection();
    
    $data = json_decode(file_get_contents("php://input"));
    
    if (!empty($data->email) && !empty($data->password)) {
        $query = "SELECT id, name, email, password, department, phone FROM faculty WHERE email = :email";
        $stmt = $db->prepare($query);
        $stmt->bindParam(":email", $data->email);
        $stmt->execute();
        
        if ($stmt->rowCount() == 1) {
            $row = $stmt->fetch();
            
            if (password_verify($data->password, $row['password'])) {
                http_response_code(200);
                echo json_encode([
                    "message" => "Login successful",
                    "faculty" => [
                        "id" => $row['id'],
                        "name" => $row['name'],
                        "email" => $row['email'],
                        "department" => $row['department'],
                        "phone" => $row['phone']
                    ]
                ]);
            } else {
                http_response_code(401);
                echo json_encode(["message" => "Invalid credentials"]);
            }
        } else {
            http_response_code(401);
            echo json_encode(["message" => "Faculty not found"]);
        }
    } else {
        http_response_code(400);
        echo json_encode(["message" => "Incomplete data"]);
    }
}

