// =============================================
// api/search/course.php - Search by Course
// =============================================

setCorsHeaders();
require_once '../config/database.php';

if ($_SERVER['REQUEST_METHOD'] === 'GET') {
    $database = new Database();
    $db = $database->getConnection();
    
    $course_name = isset($_GET['course_name']) ? $_GET['course_name'] : '';
    
    if (!empty($course_name)) {
        $query = "SELECT DISTINCT 
                    f.id as faculty_id,
                    f.name as faculty_name,
                    f.email as faculty_email,
                    f.department,
                    co.course_name,
                    co.course_code,
                    c.id as consultation_id,
                    c.day_of_week,
                    c.start_time,
                    c.end_time,
                    c.location
                  FROM consultations c
                  JOIN faculty f ON c.faculty_id = f.id
                  JOIN courses co ON c.course_id = co.id
                  WHERE co.course_name LIKE :course_name 
                  AND f.is_registered = TRUE
                  AND c.is_active = TRUE
                  ORDER BY f.name, c.day_of_week";
        
        $stmt = $db->prepare($query);
        $search_term = "%{$course_name}%";
        $stmt->bindParam(":course_name", $search_term);
        $stmt->execute();
        
        $results = $stmt->fetchAll();
        
        // Group by faculty
        $grouped = [];
        foreach ($results as $row) {
            $fid = $row['faculty_id'];
            if (!isset($grouped[$fid])) {
                $grouped[$fid] = [
                    'id' => $row['faculty_id'],
                    'name' => $row['faculty_name'],
                    'email' => $row['faculty_email'],
                    'department' => $row['department'],
                    'courses' => [],
                    'consultations' => []
                ];
            }
            
            if (!in_array($row['course_name'], $grouped[$fid]['courses'])) {
                $grouped[$fid]['courses'][] = $row['course_name'];
            }
            
            $grouped[$fid]['consultations'][] = [
                'id' => $row['consultation_id'],
                'course' => $row['course_name'],
                'day' => $row['day_of_week'],
                'start_time' => $row['start_time'],
                'end_time' => $row['end_time'],
                'location' => $row['location']
            ];
        }
        
        http_response_code(200);
        echo json_encode(["data" => array_values($grouped)]);
    } else {
        http_response_code(400);
        echo json_encode(["message" => "Course name required"]);
    }
}

// =============================================
// api/search/faculty.php - Search by Faculty Name
// =============================================

setCorsHeaders();
require_once '../config/database.php';

if ($_SERVER['REQUEST_METHOD'] === 'GET') {
    $database = new Database();
    $db = $database->getConnection();
    
    $faculty_name = isset($_GET['faculty_name']) ? $_GET['faculty_name'] : '';
    
    if (!empty($faculty_name)) {
        $query = "SELECT DISTINCT 
                    f.id as faculty_id,
                    f.name as faculty_name,
                    f.email as faculty_email,
                    f.department,
                    co.course_name,
                    co.course_code,
                    c.id as consultation_id,
                    c.day_of_week,
                    c.start_time,
                    c.end_time,
                    c.location
                  FROM faculty f
                  LEFT JOIN consultations c ON f.id = c.faculty_id AND c.is_active = TRUE
                  LEFT JOIN courses co ON c.course_id = co.id
                  WHERE f.name LIKE :faculty_name 
                  AND f.is_registered = TRUE
                  ORDER BY f.name, c.day_of_week";
        
        $stmt = $db->prepare($query);
        $search_term = "%{$faculty_name}%";
        $stmt->bindParam(":faculty_name", $search_term);
        $stmt->execute();
        
        $results = $stmt->fetchAll();
        
        // Group by faculty (same logic as course search)
        $grouped = [];
        foreach ($results as $row) {
            $fid = $row['faculty_id'];
            if (!isset($grouped[$fid])) {
                $grouped[$fid] = [
                    'id' => $row['faculty_id'],
                    'name' => $row['faculty_name'],
                    'email' => $row['faculty_email'],
                    'department' => $row['department'],
                    'courses' => [],
                    'consultations' => []
                ];
            }
            
            if ($row['course_name'] && !in_array($row['course_name'], $grouped[$fid]['courses'])) {
                $grouped[$fid]['courses'][] = $row['course_name'];
            }
            
            if ($row['consultation_id']) {
                $grouped[$fid]['consultations'][] = [
                    'id' => $row['consultation_id'],
                    'course' => $row['course_name'],
                    'day' => $row['day_of_week'],
                    'start_time' => $row['start_time'],
                    'end_time' => $row['end_time'],
                    'location' => $row['location']
                ];
            }
        }
        
        http_response_code(200);
        echo json_encode(["data" => array_values($grouped)]);
    } else {
        http_response_code(400);
        echo json_encode(["message" => "Faculty name required"]);
    }
}

