// =============================================
// api/requests/faculty.php - Get Faculty Requests
// =============================================

setCorsHeaders();
require_once '../config/database.php';

if ($_SERVER['REQUEST_METHOD'] === 'GET') {
    $database = new Database();
    $db = $database->getConnection();
    
    $faculty_id = isset($_GET['faculty_id']) ? $_GET['faculty_id'] : '';
    
    if (!empty($faculty_id)) {
        $query = "SELECT 
                    cr.id,
                    cr.student_email,
                    cr.message,
                    cr.status,
                    cr.created_at,
                    co.course_name,
                    c.day_of_week,
                    c.start_time,
                    c.end_time
                  FROM consultation_requests cr
                  JOIN consultations c ON cr.consultation_id = c.id
                  JOIN courses co ON c.course_id = co.id
                  WHERE cr.faculty_id = :faculty_id
                  ORDER BY cr.created_at DESC";
        
        $stmt = $db->prepare($query);
        $stmt->bindParam(":faculty_id", $faculty_id);
        $stmt->execute();
        
        $results = $stmt->fetchAll();
        
        http_response_code(200);
        echo json_encode(["data" => $results]);
    } else {
        http_response_code(400);
        echo json_encode(["message" => "Faculty ID required"]);
    }
}

// =============================================
// api/requests/approve.php - Approve Request
// =============================================

setCorsHeaders();
require_once '../config/database.php';
require_once '../utils/email.php';

if ($_SERVER['REQUEST_METHOD'] === 'PUT') {
    $database = new Database();
    $db = $database->getConnection();
    
    $data = json_decode(file_get_contents("php://input"));
    
    if (!empty($data->request_id)) {
        // Get request details
        $get_query = "SELECT cr.student_email, f.name, co.course_name, c.day_of_week, c.start_time, c.location
                      FROM consultation_requests cr
                      JOIN faculty f ON cr.faculty_id = f.id
                      JOIN consultations c ON cr.consultation_id = c.id
                      JOIN courses co ON c.course_id = co.id
                      WHERE cr.id = :id";
        
        $get_stmt = $db->prepare($get_query);
        $get_stmt->bindParam(":id", $data->request_id);
        $get_stmt->execute();
        $request = $get_stmt->fetch();
        
        // Update status
        $update_query = "UPDATE consultation_requests SET status = 'approved' WHERE id = :id";
        $update_stmt = $db->prepare($update_query);
        $update_stmt->bindParam(":id", $data->request_id);
        
        if ($update_stmt->execute() && $request) {
            // Send email
            $subject = "Consultation Request Approved";
            $message = "<h2>Your consultation request has been approved!</h2>";
            $message .= "<p><strong>Faculty:</strong> {$request['name']}</p>";
            $message .= "<p><strong>Course:</strong> {$request['course_name']}</p>";
            $message .= "<p><strong>Day:</strong> {$request['day_of_week']}</p>";
            $message .= "<p><strong>Time:</strong> {$request['start_time']}</p>";
            $message .= "<p><strong>Location:</strong> {$request['location']}</p>";
            
            sendEmail($request['student_email'], $subject, $message);
            
            http_response_code(200);
            echo json_encode(["message" => "Request approved and email sent"]);
        } else {
            http_response_code(503);
            echo json_encode(["message" => "Unable to approve request"]);
        }
    } else {
        http_response_code(400);
        echo json_encode(["message" => "Request ID required"]);
    }
}

